# Normalise to LF in the repository; Git restores native endings on checkout.
# Lingo is built on Windows, macOS and Linux, so the working copies differ.
* text=auto eol=lf

# Windows-only launchers must keep CRLF or cmd.exe mis-parses them.
*.cmd text eol=crlf

# Binary assets Git must not touch.
*.png binary
*.ico binary
*.icns binary
