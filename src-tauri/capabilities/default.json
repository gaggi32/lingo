{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the pop-up card and the desk window may do. The key, Google, links and the update check go through the app's own commands, not plugin permissions.",
  "windows": ["main", "pop"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-center",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "clipboard-manager:allow-write-text",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
